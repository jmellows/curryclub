rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Restaurants collection
    match /restaurants/{restaurantId} {
      // Anyone authenticated can read restaurants
      allow read: if request.auth != null;
      // Anyone authenticated can create restaurants
      allow create: if request.auth != null;
      // Anyone authenticated can update restaurants (for locking)
      allow update: if request.auth != null;
      // Admin or any authenticated user can delete restaurants (temporarily allow for cleanup)
      allow delete: if request.auth != null;

      // Ratings subcollection
      match /ratings/{ratingId} {
        // Anyone authenticated can read ratings
        allow read: if request.auth != null;
        // Users can write their own ratings OR admin can delete
        allow write: if request.auth != null && request.auth.uid == ratingId;
        allow delete: if request.auth != null;
      }
    }

    // Tonight's pick
    match /tonightsPick/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Sessions collection - for analytics
    match /sessions/{userId} {
      // Users can write their own session
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Admin can read all sessions
      allow read: if request.auth != null && request.auth.token.email == 'jmellowsjnr@gmail.com';

      // Session history subcollection
      match /history/{historyId} {
        // Users can write their own history
        allow write: if request.auth != null && request.auth.uid == userId;
        // Admin can read all history
        allow read: if request.auth != null && request.auth.token.email == 'jmellowsjnr@gmail.com';
      }
    }

    // Notifications collection - for broadcasting funny notifications
    match /notifications/{notificationId} {
      // Any authenticated user can read notifications
      allow read: if request.auth != null;
      // Any authenticated user can create notifications
      allow create: if request.auth != null;
      // Admin can delete old notifications
      allow delete: if request.auth != null && request.auth.token.email == 'jmellowsjnr@gmail.com';
    }

    // Feature Requests collection
    match /featureRequests/{requestId} {
      // Any authenticated user can create feature requests
      allow create: if request.auth != null;
      // Admin can read and delete
      allow read, delete: if request.auth != null && request.auth.token.email == 'jmellowsjnr@gmail.com';
    }

    // Event Attendees collection - for RSVP and attendance tracking
    match /eventAttendees/{restaurantId}/attendees/{userId} {
      // Users can create/update/delete their own attendance
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      // Any authenticated user can read all attendees
      allow read: if request.auth != null;
    }

    // Rating Reports collection - generated when all attendees have rated
    match /ratingReports/{restaurantId} {
      // Any authenticated user can read reports
      allow read: if request.auth != null;
      // Any authenticated user can create reports (automated)
      allow create: if request.auth != null;
      // Admin can delete reports
      allow delete: if request.auth != null && request.auth.token.email == 'jmellowsjnr@gmail.com';
    }

    // Event Photos collection - for photo uploads
    match /eventPhotos/{restaurantId}/photos/{photoId} {
      // Any authenticated user can read photos
      allow read: if request.auth != null;
      // Only attendees can create photos (must be their own userId)
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Users can delete their own photos
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // Admin can delete any photos
      allow delete: if request.auth != null && request.auth.token.email == 'jmellowsjnr@gmail.com';
    }

    // Storage Tracking collection - for monitoring storage usage
    match /storageTracking/{document=**} {
      // Any authenticated user can read storage stats
      allow read: if request.auth != null;
      // Any authenticated user can write (for tracking uploads)
      allow write: if request.auth != null;
    }
  }
}
